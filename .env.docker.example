# Copy to .env (next to docker-compose.yml) and fill in. Never commit the real file.

# Public address people use to reach the app — must match exactly what's in the browser.
# Microsoft only accepts https:// redirect URIs, or http://localhost.
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Generate each secret with:  openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
# Encrypts stored mailbox passwords/tokens — set once and keep it; changing it
# makes existing mailbox credentials unreadable (you'd have to re-enter them).
ENCRYPTION_KEY=

# First super-admin login (the password is re-applied on every start)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# Microsoft 365 / Exchange Online (optional — see README "Microsoft 365 setup")
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google OAuth (optional — not needed when using Gmail app passwords)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
