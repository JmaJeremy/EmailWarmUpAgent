# ─── Database ───────────────────────────────────────────────────
# Local SQLite (default - no setup needed)
DATABASE_URL=sqlite:///./neurogenix_warmup.db

# Railway PostgreSQL (swap when deploying)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── JWT Auth ───────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── Super Admin (Neurogenix) ───────────────────────────────────
SUPER_ADMIN_EMAIL=admin@neurogenix.ai
SUPER_ADMIN_PASSWORD=Neurogenix@2025!

# ─── Encryption (for SMTP/IMAP passwords) ───────────────────────
ENCRYPTION_KEY=your-32-byte-encryption-key-base64-encoded

# ─── File Uploads ───────────────────────────────────────────────
UPLOAD_DIR=uploads/logos

# ─── Warmup Engine ──────────────────────────────────────────────
WARMUP_RUN_HOUR=9
WARMUP_RUN_MINUTE=0

# ─── Redis (only needed for Railway/Celery - optional locally) ──
REDIS_URL=redis://localhost:6379/0

# ─── App Config ─────────────────────────────────────────────────
APP_NAME=NeuroGenix WarmUp
APP_VERSION=1.0.0
DEBUG=true
FRONTEND_URL=http://localhost:5173
